# Copy to .env and fill in. Keep .env out of git: it holds the setup key.

# A setup key from the NetBird dashboard (Setup Keys). Reusable or one-off.
NB_SETUP_KEY=
# Your NetBird management URL, for example https://netbird.example.com
NB_MANAGEMENT_URL=

# Service domains, exactly as created in the NetBird dashboard.
TICKETS_DOMAIN=tickets.example.com
WHOAMI_DOMAIN=whoami.example.com

# whoami: headers or jwt. In jwt mode WHOAMI_DOMAIN must be set.
WHOAMI_MODE=headers

# Header that carries the JWT, matching the service's JWT header setting:
# X-NetBird-Identity or Authorization.
TICKETS_JWT_HEADER=X-NetBird-Identity
WHOAMI_JWT_HEADER=X-NetBird-Identity
